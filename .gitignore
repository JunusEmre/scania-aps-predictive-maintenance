*.pkl
*.pickle
*.joblib

# Environment files / secrets
.env
.env.*
!.env.example

# Test/cache
.pytest_cache/
.coverage

# Generated outputs
reports/figures/*
!reports/figures/.gitkeep

reports/results/*
!reports/results/.gitkeep
